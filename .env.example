# Copy this file to .env for local development. Never commit .env.
# Nothing in this app needs a secret to talk to Swiggy: it uses OAuth 2.1 with PKCE as a public
# client, so there is no client secret and no API key to configure.

# Port the server listens on. Hosting platforms such as Render set this themselves.
PORT=3000

# Public address of THIS app, with no path and no trailing slash.
#   Local development: http://localhost:3000
#   Render:            https://orderwiseai.onrender.com
# The OAuth redirect URI is this value plus /auth/swiggy/callback.
# If this is empty or invalid, Swiggy sign-in is switched off and the rest of the app still works.
APP_BASE_URL=http://localhost:3000

# Optional. The client_id printed by `npm run swiggy:register`. A client_id is a public
# identifier, not a secret. Set it in production so the server does not register a new client
# every time it restarts.
# SWIGGY_CLIENT_ID=your-client-id-here

# Optional overrides. The defaults are the production values from the Swiggy Builders docs.
# SWIGGY_AUTH_BASE_URL=https://mcp.swiggy.com
# SWIGGY_FOOD_MCP_URL=https://mcp.swiggy.com/food
# SWIGGY_SCOPE=mcp:tools
